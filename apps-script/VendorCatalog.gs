function importVendorCatalog() {
  const ss = ensureSetup();
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  let inserted = 0;
  let existing = 0;
  try {
    const seen = new Set(readAll(ss).vendors.map(function (vendor) {
      return normalizeVendorName(vendor.name);
    }));
    const records = [];
    VENDOR_CATALOG.forEach(function (entry) {
      const name = normalizeVendorName(entry[0]);
      if (seen.has(name)) {
        existing += 1;
        return;
      }
      seen.add(name);
      records.push({ id: Utilities.getUuid(), name: name, category: String(entry[1] || "").trim() || null });
    });

    if (records.length) {
      const table = TABLES.vendors;
      const meta = headerIndex(ss, "vendors");
      const rows = records.map(function (record) {
        return table.headers.map(function (header) {
          return serializeValue(header, record[header]);
        });
      });
      const start = Math.max(meta.sheet.getLastRow(), 1) + 1;
      meta.sheet.getRange(start, 1, rows.length, table.headers.length).setValues(rows);
      inserted = records.length;
    }
  } finally {
    lock.releaseLock();
  }
  return { inserted: inserted, existing: existing, total: VENDOR_CATALOG.length };
}

function normalizeVendorName(value) {
  return String(value || "").trim().replace(/\s+/g, " ");
}
